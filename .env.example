ENVIRONMENT=development
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dma_py
DATABASE_ECHO=false

# Use long random values in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me-please
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
EXTRACTION_DELAY_MS=1500
